# Google Apps Script endpoint — same URL used by the DB admin tool.
# Set this in .env.local (dev) or Netlify environment variables (production).
# Your partner will provide the deployed /exec URL.
VITE_BUTLER_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Stripe (checkout). Secret key: Netlify env vars / .env.local only — never commit.
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# Turn the cart on in a build (always on in dev)
VITE_CART_ENABLED=
